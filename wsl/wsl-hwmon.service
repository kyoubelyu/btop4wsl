[Unit]
Description=Bridge LibreHardwareMonitor (Windows host) sensors into WSL hwmon for btop
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/local/lib/btop4wsl/wsl-hwmon-mount.sh mount
ExecStart=/usr/bin/python3 /usr/local/lib/btop4wsl/wsl-hwmon-bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
